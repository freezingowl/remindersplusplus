# Deploy worker/worker.mjs first, then configure Cue with its HTTPS origin.
EXPO_PUBLIC_CUE_WORKER_URL=https://cue-ai.YOUR-SUBDOMAIN.workers.dev
# A separate random app access token; match Cloudflare's CUE_CLIENT_TOKEN secret.
# This token is shipped to the app. It is NOT an OpenAI key or user authentication.
EXPO_PUBLIC_CUE_CLIENT_TOKEN=
# Keep OPENAI_API_KEY only in Cloudflare Secrets, never in the app environment.
