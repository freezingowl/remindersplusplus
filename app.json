{
  "expo": {
    "name": "Cue",
    "slug": "cue-reminders",
    "version": "1.0.0",
    "scheme": "cue",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Cue to use your microphone so it can turn spoken reminders into cards.",
          "recordAudioAndroid": true
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "./plugins/withIosBuildPathQuotes.cjs"
    ],
    "ios": {
      "bundleIdentifier": "com.remindersplusplus.cue",
      "supportsTablet": true
    },
    "android": {
      "package": "com.remindersplusplus.cue",
      "edgeToEdgeEnabled": true
    }
  }
}
