{
  "name": "cue-reminders",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start --localhost",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:dev": "expo start --dev-client --lan",
    "start:dev:tunnel": "expo start --dev-client --tunnel",
    "android": "expo start --android --localhost",
    "android:device": "expo start --lan --go",
    "ios": "expo start --ios --localhost",
    "ios:simulator": "expo start --ios --localhost",
    "ios:go:device": "expo start --lan --go",
    "ios:device": "expo run:ios --device",
    "ios:build:device": "expo run:ios --device --no-bundler",
    "ios:sync:companion": "node scripts/syncCompanion.cjs",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:ios:paths": "node --test tests/ios-build-paths.test.cjs",
    "test:companion": "node --test tests/companion.test.cjs",
    "lint": "eslint .",
    "test:worker": "node --test tests/worker.test.mjs",
    "ios:build:standalone": "expo run:ios --device --configuration Release --no-bundler",
    "cloud:check": "node scripts/checkCloud.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.14",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  }
}
